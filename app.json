{
  "expo": {
    "name": "lookfinder",
    "slug": "lookfinderMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-app.png",
    "scheme": "lookfindermobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asaphcruz.lookfinderMobile",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"],
        "NSPhotoLibraryUsageDescription": "Este app precisa acessar sua biblioteca de fotos para permitir que você selecione e faça upload de imagens para seu perfil.",
        "NSCameraUsageDescription": "Este app precisa acessar sua câmera para permitir que você tire fotos e faça upload para seu perfil.",
        "NSPhotoLibraryAddUsageDescription": "Este app precisa salvar imagens na sua biblioteca de fotos quando você fizer upload de fotos de perfil."
      }
    },
    "android": {
      "package": "com.asaphcruz.lookfinderMobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3f689b8a-86a1-4e20-8674-13f05630422a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f689b8a-86a1-4e20-8674-13f05630422a"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-app.png",
          "color": "#ffffff",
          "defaultChannel": "lookfinder-notifications"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-app.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "asaphcruz"
  }
}